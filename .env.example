# Copy this file to .env and fill Cognito values from CloudFormation Outputs.
PORT=3001
AWS_PROFILE=student-drive
STORAGE_MODE=aws
AUTH_MODE=cognito
AWS_REGION=ap-south-1
DYNAMODB_TABLE=StudentDrive_Main
S3_BUCKET=student-drive-demo-submissionsbucket-p8wz5kbxvtiz
COGNITO_USER_POOL_ID=replace-with-CognitoUserPoolId-output
COGNITO_CLIENT_ID=replace-with-CognitoAppClientId-output
